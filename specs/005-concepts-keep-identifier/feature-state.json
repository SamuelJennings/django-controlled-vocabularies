  "gates": {
    "spec": {
      "approved_by": "Sam",
      "at": "2026-08-03T10:20:00Z",
      "self_resolved": [
        "Identifier validation: absolute URI with a scheme; javascript/data/vbscript refused; 500-character cap (urn: accepted)",
        "Fixedness never reverses; a re-import matches by the identifier so never rewrites it",
        "The published uri accessor and get_by_uri keep their names and meanings; local_url is the only new name",
        "local_url gets no routes or views here; R4 serving and R6 browsing bring their own",
        "CONTEXT.md's single URI glossary entry splits into permanent URI and local URL, landing with this feature"
      ]
    },
    "plan": {
      "approved_by": null,
      "at": null,
      "self_resolved": [
        "Stored column holds external identifiers only; provisional ones compose on read (research R1) - the always-stored alternative fails FR-005's configured-address clause",
        "Fixedness is the presence of the stored value, not a companion boolean (research R2)",
        "Per-model unique constraint plus a cross-model validation check; shared Identifier table rejected as premature (research R4)",
        "Validation runs in save() as well as on the field, because save() never calls full_clean() (research R5)",
        "No data migration or backfill: pre-existing rows compose exactly as before (FR-009 satisfied by construction)"
      ]
    },
    "merge": {
      "approved_by": null,
      "at": null
    }
  },
