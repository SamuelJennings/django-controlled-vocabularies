@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FIX 9 (review, decisions.md D42), second half of the pair — see
# shared_collection_vocab_a.ttl. Same collection identifier, a different
# declared vocabulary, a different member.

<http://example.org/shared-collection/vocab-b/>
    a skos:ConceptScheme ;
    skos:prefLabel "Vocabulary B"@en .

<http://example.org/shared-collection/vocab-b/concept-b>
    a skos:Concept ;
    skos:inScheme <http://example.org/shared-collection/vocab-b/> ;
    skos:prefLabel "Concept B"@en .

<http://example.org/shared/coll>
    a skos:Collection ;
    skos:prefLabel "Shared collection"@en ;
    skos:member <http://example.org/shared-collection/vocab-b/concept-b> .
