@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FIX 5 (review, decisions.md D39), updated by T029 (decisions.md D35): the
# slug now derives from the published identifier's own segment, not the
# label, so what can slugify to nothing is that segment — here, a fragment
# made up only of characters slugify() strips ("±"). Concept.save() raises
# "An explicit slug must not be empty" for this; the identifier and the
# label are both otherwise perfectly usable, so the concept must be set
# aside and reported rather than crash the run.

<http://example.org/emptyslug/>
    a skos:ConceptScheme ;
    skos:prefLabel "Empty slug"@en .

<http://example.org/emptyslug/symbol#±>
    a skos:Concept ;
    skos:inScheme <http://example.org/emptyslug/> ;
    skos:prefLabel "Symbol"@en .

<http://example.org/emptyslug/normal>
    a skos:Concept ;
    skos:inScheme <http://example.org/emptyslug/> ;
    skos:prefLabel "Normal"@en ;
    skos:altLabel "Normal-alt"@en .
