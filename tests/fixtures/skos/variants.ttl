@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# T005/FR-015/SC-020: several variants of one base language (en) for one
# concept, spread across a preferred label, an alternative label, and a
# note — no exact "en" tag anywhere, so the contest population US-3 needs is
# exercised without also needing a bare-base anchor.

<http://example.org/colours/>
    a skos:ConceptScheme ;
    skos:prefLabel "Colours"@en-gb .

<http://example.org/colours/colour>
    a skos:Concept ;
    skos:inScheme <http://example.org/colours/> ;
    skos:prefLabel "Colour"@en-gb, "Color"@en-us ;
    skos:altLabel "Colour"@en-gb, "Color"@en-us ;
    skos:note "Spelling follows regional convention."@en-gb, "Spelling follows regional convention."@en-us .
