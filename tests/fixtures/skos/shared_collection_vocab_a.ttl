@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FIX 9 (review, decisions.md D42), first half of the pair. Declares its own
# vocabulary and names a collection identifier that shared_collection_vocab_b.ttl
# also declares, from a different vocabulary, with a different member — the
# same identity conflict FIX 8 closes for a concept, applied to a collection.

<http://example.org/shared-collection/vocab-a/>
    a skos:ConceptScheme ;
    skos:prefLabel "Vocabulary A"@en .

<http://example.org/shared-collection/vocab-a/concept-a>
    a skos:Concept ;
    skos:inScheme <http://example.org/shared-collection/vocab-a/> ;
    skos:prefLabel "Concept A"@en .

<http://example.org/shared/coll>
    a skos:Collection ;
    skos:prefLabel "Shared collection"@en ;
    skos:member <http://example.org/shared-collection/vocab-a/concept-a> .
