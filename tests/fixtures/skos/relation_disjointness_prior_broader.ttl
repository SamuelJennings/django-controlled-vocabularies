@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FIX 2 (review, decisions.md D37), the symmetric route — a broader row an
# earlier import created can just as easily survive into a later run that
# then states the same pair as related, the mirror image of route 2 above.
# b drops out of the second file entirely
# (relation_disjointness_prior_broader_updated.ttl), so the existing
# broader row is never a deletion candidate (D30), and add_related would
# otherwise crash on it.

<http://example.org/disjoint3/>
    a skos:ConceptScheme ;
    skos:prefLabel "Disjointness reimport broader"@en .

<http://example.org/disjoint3/a>
    a skos:Concept ;
    skos:inScheme <http://example.org/disjoint3/> ;
    skos:prefLabel "A"@en ;
    skos:broader <http://example.org/disjoint3/b> .

<http://example.org/disjoint3/b>
    a skos:Concept ;
    skos:inScheme <http://example.org/disjoint3/> ;
    skos:prefLabel "B"@en .
