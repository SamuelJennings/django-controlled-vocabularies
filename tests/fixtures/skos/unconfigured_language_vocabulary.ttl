@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FR-005/D4: a vocabulary published in Spanish, a language the test site is
# not configured for at all (LANGUAGES = en/de/fr). Neither the vocabulary's
# own declared language nor its concepts' commonest preferred-label language
# is configured, so the default language must fall back to the site's own
# default (en) rather than being left unusable.

<http://example.org/geology2/>
    a skos:ConceptScheme ;
    skos:prefLabel "Tipos de rocas"@es .

<http://example.org/geology2/igneous>
    a skos:Concept ;
    skos:inScheme <http://example.org/geology2/> ;
    skos:prefLabel "Roca ígnea"@es .
