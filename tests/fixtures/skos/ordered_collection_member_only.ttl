@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FIX 11 (review, decisions.md D44). An OrderedCollection stated only with
# skos:member — no skos:memberList at all. Members carry no order of their
# own; imported in the same deterministic sorted order the unordered branch
# already uses.

<http://example.org/ordered-member-only/>
    a skos:ConceptScheme ;
    skos:prefLabel "Ordered via member only"@en .

<http://example.org/ordered-member-only/alpha>
    a skos:Concept ;
    skos:inScheme <http://example.org/ordered-member-only/> ;
    skos:prefLabel "Alpha"@en .

<http://example.org/ordered-member-only/beta>
    a skos:Concept ;
    skos:inScheme <http://example.org/ordered-member-only/> ;
    skos:prefLabel "Beta"@en .

<http://example.org/ordered-member-only/collection/group>
    a skos:OrderedCollection ;
    skos:prefLabel "Group"@en ;
    skos:member
        <http://example.org/ordered-member-only/beta>,
        <http://example.org/ordered-member-only/alpha> .
