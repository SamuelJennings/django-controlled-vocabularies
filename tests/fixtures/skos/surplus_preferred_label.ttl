@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FIX 3 (review, decisions.md D38) — two skos:prefLabel values in one
# non-default configured language ("de"). ConceptLabel.clean() allows at
# most one PREFERRED row per (concept, language); one of these two must be
# kept deterministically and the other set aside and reported rather than
# crashing the run on the model's own refusal.

<http://example.org/surplus/>
    a skos:ConceptScheme ;
    skos:prefLabel "Surplus"@en .

<http://example.org/surplus/gadget>
    a skos:Concept ;
    skos:inScheme <http://example.org/surplus/> ;
    skos:prefLabel "Gadget"@en, "Gerät"@de, "Apparat"@de .
