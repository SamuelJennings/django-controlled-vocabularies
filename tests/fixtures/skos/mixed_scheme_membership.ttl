@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# T009: exercises all three ways a concept can declare scheme membership —
# the scheme's own skos:hasTopConcept (quartz), the concept's own
# skos:inScheme (feldspar), and skos:topConceptOf (mica) — plus a concept
# that explicitly claims a *different* vocabulary (foreign), which must be
# set aside and reported rather than imported (spec Edge Cases §1).

<http://example.org/minerals/>
    a skos:ConceptScheme ;
    skos:prefLabel "Minerals"@en ;
    skos:hasTopConcept <http://example.org/minerals/quartz> .

<http://example.org/minerals/quartz>
    a skos:Concept ;
    skos:prefLabel "Quartz"@en .

<http://example.org/minerals/feldspar>
    a skos:Concept ;
    skos:inScheme <http://example.org/minerals/> ;
    skos:prefLabel "Feldspar"@en .

<http://example.org/minerals/mica>
    a skos:Concept ;
    skos:topConceptOf <http://example.org/minerals/> ;
    skos:prefLabel "Mica"@en .

<http://example.org/other/>
    a skos:ConceptScheme ;
    skos:prefLabel "Other vocabulary"@en .

<http://example.org/minerals/foreign>
    a skos:Concept ;
    skos:inScheme <http://example.org/other/> ;
    skos:prefLabel "Foreign concept"@en .
