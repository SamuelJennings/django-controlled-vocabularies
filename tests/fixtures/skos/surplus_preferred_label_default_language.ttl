@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FIX 4 (review, decisions.md D38) — two skos:prefLabel values in the
# vocabulary's *default* language ("en"). _preferred_label_in already picks
# one of these deterministically as Concept.label; the loser must be
# reported, not dropped in silence (Article XI, README's "nothing a file
# contains is ever dropped in silence").

<http://example.org/surplus2/>
    a skos:ConceptScheme ;
    skos:prefLabel "Surplus Two"@en .

<http://example.org/surplus2/widget>
    a skos:Concept ;
    skos:inScheme <http://example.org/surplus2/> ;
    skos:prefLabel "Widget"@en, "Doohickey"@en .
