@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# T020/FR-014: a concept carrying label and note values in a language the
# test site is not configured for at all (LANGUAGES = en/de/fr; this file
# uses Spanish, "es"). Those values must be stored nowhere and named in the
# report with their language, and the concept must still import on its
# configured-language content alone.

<http://example.org/quarry3/>
    a skos:ConceptScheme ;
    skos:prefLabel "Quarry Three"@en .

<http://example.org/quarry3/schist>
    a skos:Concept ;
    skos:inScheme <http://example.org/quarry3/> ;
    skos:prefLabel "Schist"@en ;
    skos:altLabel "Esquisto uno"@es, "Esquisto dos"@es ;
    skos:scopeNote "Nota de alcance"@es .
