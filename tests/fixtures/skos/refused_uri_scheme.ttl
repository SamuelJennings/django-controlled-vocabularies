@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Fatal path (FR-004, models.validate_static_uri): the concept has a real,
# non-blank identifier, but its scheme ("ftp") is outside the application's
# configured allowlist (conf.DEFAULT_ALLOWED_URI_SCHEMES), so the identity
# rules refuse it and the run must fail and name it.

<http://example.org/rocks/>
    a skos:ConceptScheme ;
    skos:prefLabel "Rock types"@en .

<ftp://mirror.example.org/rocks/basalt>
    a skos:Concept ;
    skos:inScheme <http://example.org/rocks/> ;
    skos:prefLabel "Basalt"@en .
