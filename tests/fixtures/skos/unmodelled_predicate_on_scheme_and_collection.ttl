@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/custom#> .

# FIX 12 (review, decisions.md D45). A non-SKOS predicate on the vocabulary's
# own scheme node, and on a collection node — neither was ever walked by
# _import_unheld_values, which only ever ran once per concept.

<http://example.org/scheme-collection-unmodelled/>
    a skos:ConceptScheme ;
    skos:prefLabel "Scheme and collection unmodelled predicates"@en ;
    ex:owner "Someone"@en .

<http://example.org/scheme-collection-unmodelled/alpha>
    a skos:Concept ;
    skos:inScheme <http://example.org/scheme-collection-unmodelled/> ;
    skos:prefLabel "Alpha"@en .

<http://example.org/scheme-collection-unmodelled/collection/group>
    a skos:Collection ;
    skos:prefLabel "Group"@en ;
    skos:member <http://example.org/scheme-collection-unmodelled/alpha> ;
    ex:curatedBy "Someone"@en .
