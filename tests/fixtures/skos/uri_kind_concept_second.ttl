@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FIX 10 (review, decisions.md D43), second half of the pair — see
# uri_kind_collection_first.ttl.

<http://example.org/kind-clash/>
    a skos:ConceptScheme ;
    skos:prefLabel "Kind clash"@en .

<http://example.org/kind-clash/thing>
    a skos:Concept ;
    skos:inScheme <http://example.org/kind-clash/> ;
    skos:prefLabel "Thing (as a concept)"@en .
