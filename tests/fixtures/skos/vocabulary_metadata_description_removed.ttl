@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# T016: a further re-import of vocabulary_metadata.ttl in which the publisher
# has dropped the description entirely. The file is authoritative for what
# it contains (D5), so the stored description must clear, not linger.

<http://example.org/gems/>
    a skos:ConceptScheme ;
    skos:prefLabel "Gemstones"@en ;
    skos:hasTopConcept <http://example.org/gems/diamond> .

<http://example.org/gems/diamond>
    a skos:Concept ;
    skos:inScheme <http://example.org/gems/> ;
    skos:prefLabel "Diamond"@en .
