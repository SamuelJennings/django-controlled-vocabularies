@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FIX 10 (review, decisions.md D43), first half of the pair. "thing" is a
# skos:Collection here and a skos:Concept in uri_kind_concept_second.ttl —
# the same static URI held by a record of a different kind, spec Edge
# Cases' own example ("a collection in one file, a concept in another").

<http://example.org/kind-clash/>
    a skos:ConceptScheme ;
    skos:prefLabel "Kind clash"@en .

<http://example.org/kind-clash/thing>
    a skos:Collection ;
    skos:prefLabel "Thing (as a collection)"@en .
