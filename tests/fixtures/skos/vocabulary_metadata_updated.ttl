@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# T016: the re-import edit of vocabulary_metadata.ttl — the publisher has
# renamed the vocabulary and rewritten its description. The identifier
# (<http://example.org/gems/>) is untouched.

<http://example.org/gems/>
    a skos:ConceptScheme ;
    skos:prefLabel "Precious stones"@en ;
    dcterms:description "An updated vocabulary of gemstones and precious stones."@en ;
    skos:hasTopConcept <http://example.org/gems/diamond> .

<http://example.org/gems/diamond>
    a skos:Concept ;
    skos:inScheme <http://example.org/gems/> ;
    skos:prefLabel "Diamond"@en .
