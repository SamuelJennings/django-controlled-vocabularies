@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Both directions of the same broader/narrower pair, and both directions of
# the same related pair, each stated in the same file (spec.md US-4
# acceptance 3, tasks.md T023; acceptance 4/T024's "stated twice"). Importing
# this must produce exactly one ConceptRelation row per pair, never two.

<http://example.org/hierarchy/>
    a skos:ConceptScheme ;
    skos:prefLabel "Hierarchy and association"@en .

<http://example.org/hierarchy/parent>
    a skos:Concept ;
    skos:inScheme <http://example.org/hierarchy/> ;
    skos:prefLabel "Parent"@en ;
    skos:narrower <http://example.org/hierarchy/child> .

<http://example.org/hierarchy/child>
    a skos:Concept ;
    skos:inScheme <http://example.org/hierarchy/> ;
    skos:prefLabel "Child"@en ;
    skos:broader <http://example.org/hierarchy/parent> .

<http://example.org/hierarchy/east>
    a skos:Concept ;
    skos:inScheme <http://example.org/hierarchy/> ;
    skos:prefLabel "East"@en ;
    skos:related <http://example.org/hierarchy/west> .

<http://example.org/hierarchy/west>
    a skos:Concept ;
    skos:inScheme <http://example.org/hierarchy/> ;
    skos:prefLabel "West"@en ;
    skos:related <http://example.org/hierarchy/east> .
