@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FIX 2 (review, decisions.md D37) — the same pair stated as both
# skos:broader and skos:related in one file. SKOS declares the two
# relations mutually exclusive (models.py
# ConceptRelation._reject_disjointness_violation); the hierarchical
# relation wins and the related statement is set aside.

<http://example.org/disjoint/>
    a skos:ConceptScheme ;
    skos:prefLabel "Disjointness"@en .

<http://example.org/disjoint/child>
    a skos:Concept ;
    skos:inScheme <http://example.org/disjoint/> ;
    skos:prefLabel "Child"@en ;
    skos:broader <http://example.org/disjoint/parent> ;
    skos:related <http://example.org/disjoint/parent> .

<http://example.org/disjoint/parent>
    a skos:Concept ;
    skos:inScheme <http://example.org/disjoint/> ;
    skos:prefLabel "Parent"@en .
