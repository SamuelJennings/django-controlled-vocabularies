@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FR-006/decisions.md D14: a concept with no preferred label in the
# vocabulary's default language (here "en", declared explicitly by the
# scheme's own single-language skos:prefLabel) must be set aside and
# reported, and must not fail the run — the rest of the vocabulary still
# imports, complete with whatever labels it carries (T022, decisions.md D17's
# "finished" acceptance: "b" carries an alternative label so the rest of the
# vocabulary's own US-3 content is proven to land, not only its identity).

<http://example.org/quarry/>
    a skos:ConceptScheme ;
    skos:prefLabel "Quarry"@en .

<http://example.org/quarry/a>
    a skos:Concept ;
    skos:inScheme <http://example.org/quarry/> ;
    skos:prefLabel "A"@en .

<http://example.org/quarry/b>
    a skos:Concept ;
    skos:inScheme <http://example.org/quarry/> ;
    skos:prefLabel "B"@en ;
    skos:altLabel "B-alt"@en .

<http://example.org/quarry/c>
    a skos:Concept ;
    skos:inScheme <http://example.org/quarry/> ;
    skos:prefLabel "C"@fr .
