@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# The re-import edit of rocks.ttl (US-2/US-3 scenarios): granite's preferred label is
# corrected, its "Magma rock" alternative label is dropped, basalt's "example" note
# is dropped, quartz is removed from the file entirely (taking granite's related edge
# and its own collection membership with it), and the ordered collection's member
# sequence changes. sedimentary is otherwise unchanged and still present here, so a
# re-import must leave it untouched and name it as still absent from this file's
# mention where applicable. (decisions.md D24: the note-removal edit was added here
# for US-3's T019, which needs a note dropped from a concept that stays present —
# the original four re-import edits covered no such case.)

<http://example.org/rocks/>
    a skos:ConceptScheme ;
    skos:prefLabel "Rock types"@en ;
    skos:hasTopConcept <http://example.org/rocks/igneous>, <http://example.org/rocks/sedimentary> .

<http://example.org/rocks/igneous>
    a skos:Concept ;
    skos:inScheme <http://example.org/rocks/> ;
    skos:topConceptOf <http://example.org/rocks/> ;
    skos:prefLabel "Igneous rock"@en, "Magmatisches Gestein"@de, "Roche ignée"@fr ;
    skos:definition "Rock formed by the cooling and solidification of magma or lava."@en ;
    skos:narrower <http://example.org/rocks/basalt> .

<http://example.org/rocks/granite>
    a skos:Concept ;
    skos:inScheme <http://example.org/rocks/> ;
    skos:prefLabel "Granite (revised)"@en, "Granit"@de, "Granite"@fr ;
    skos:hiddenLabel "Granit rock"@en ;
    skos:scopeNote "Used here for coarse-grained intrusive igneous rock."@en ;
    skos:broader <http://example.org/rocks/igneous> .

<http://example.org/rocks/basalt>
    a skos:Concept ;
    skos:inScheme <http://example.org/rocks/> ;
    skos:prefLabel "Basalt"@en, "Basalt"@de .

<http://example.org/rocks/sedimentary>
    a skos:Concept ;
    skos:inScheme <http://example.org/rocks/> ;
    skos:topConceptOf <http://example.org/rocks/> ;
    skos:prefLabel "Sedimentary rock"@en, "Roche sédimentaire"@fr ;
    skos:editorialNote "Confirm classification against the regional survey before publishing."@en .

<http://example.org/rocks/collection/silica-bearing>
    a skos:Collection ;
    skos:prefLabel "Silica-bearing rocks"@en ;
    skos:member <http://example.org/rocks/granite> .

<http://example.org/rocks/collection/example-sequence>
    a skos:OrderedCollection ;
    skos:prefLabel "Example sequence"@en ;
    skos:memberList ( <http://example.org/rocks/granite> <http://example.org/rocks/sedimentary> <http://example.org/rocks/basalt> ) .
