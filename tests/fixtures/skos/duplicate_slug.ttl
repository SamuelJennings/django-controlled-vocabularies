@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FR-007/decisions.md D6: two concepts with distinct identifiers that share
# the same preferred label, so both derive the same slug ("quartz"). The
# second must get a deterministic numeric suffix rather than being refused,
# and re-importing this file must give each concept the same slug both
# times. Identifiers are chosen so their alphabetical order is predictable
# (quartz-a before quartz-b): concept_nodes are processed in a stable,
# URI-sorted order, so quartz-a always claims the plain slug.

<http://example.org/quarry2/>
    a skos:ConceptScheme ;
    skos:prefLabel "Quarry Two"@en .

<http://example.org/quarry2/quartz-a>
    a skos:Concept ;
    skos:inScheme <http://example.org/quarry2/> ;
    skos:prefLabel "Quartz"@en .

<http://example.org/quarry2/quartz-b>
    a skos:Concept ;
    skos:inScheme <http://example.org/quarry2/> ;
    skos:prefLabel "Quartz"@en .
