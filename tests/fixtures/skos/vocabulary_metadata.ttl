@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# T016: SKOS has no description predicate for a skos:ConceptScheme; this
# feature reads it from dcterms:description (decisions.md D21), the same
# alias CONTEXT.md already establishes for a concept's own definition.

<http://example.org/gems/>
    a skos:ConceptScheme ;
    skos:prefLabel "Gemstones"@en ;
    dcterms:description "A vocabulary of gemstone types."@en ;
    skos:hasTopConcept <http://example.org/gems/diamond> .

<http://example.org/gems/diamond>
    a skos:Concept ;
    skos:inScheme <http://example.org/gems/> ;
    skos:prefLabel "Diamond"@en .
