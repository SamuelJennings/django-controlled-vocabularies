@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# The re-import half of the pair (see relation_lifecycle.ttl). quarry drops
# its related edge to vein here — both concepts remain present, so this is a
# genuine retraction FR-013 requires this run to apply. outlier is gone from
# this file altogether, taking quarry's edge to it out of the graph along
# with it; decisions.md D30 leaves that edge exactly as it was, since
# outlier's own end was never rewritten by this run. quarry restates its
# edge to companion unchanged, so the removal above can be shown to be
# selective rather than a wipe of every edge touching quarry.

<http://example.org/lifecycle/>
    a skos:ConceptScheme ;
    skos:prefLabel "Relation lifecycle"@en .

<http://example.org/lifecycle/quarry>
    a skos:Concept ;
    skos:inScheme <http://example.org/lifecycle/> ;
    skos:prefLabel "Quarry"@en ;
    skos:related <http://example.org/lifecycle/companion> .

<http://example.org/lifecycle/vein>
    a skos:Concept ;
    skos:inScheme <http://example.org/lifecycle/> ;
    skos:prefLabel "Vein"@en .

<http://example.org/lifecycle/companion>
    a skos:Concept ;
    skos:inScheme <http://example.org/lifecycle/> ;
    skos:prefLabel "Companion"@en .
