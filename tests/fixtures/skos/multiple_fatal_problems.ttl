@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# T011: a single file carrying two distinct fatal problems (a blank-node
# concept and a concept whose identifier scheme is refused) alongside one
# perfectly ordinary concept, so a run against it must (a) report both
# fatal findings rather than stopping at the first, and (b) roll back even
# the ordinary concept — the run is all-or-nothing (FR-003, research.md R7).

<http://example.org/mixed/>
    a skos:ConceptScheme ;
    skos:prefLabel "Mixed problems"@en .

<http://example.org/mixed/ordinary>
    a skos:Concept ;
    skos:inScheme <http://example.org/mixed/> ;
    skos:prefLabel "Ordinary"@en .

[]
    a skos:Concept ;
    skos:inScheme <http://example.org/mixed/> ;
    skos:prefLabel "Nameless"@en .

<ftp://mirror.example.org/mixed/refused>
    a skos:Concept ;
    skos:inScheme <http://example.org/mixed/> ;
    skos:prefLabel "Refused"@en .
