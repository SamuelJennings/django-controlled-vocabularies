@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# T005/SC-002: a vocabulary published only as en-gb, for the specific-to-
# general direction — a site configured only for "en" must still receive it.

<http://example.org/colours-gb/>
    a skos:ConceptScheme ;
    skos:prefLabel "Colours"@en-gb .

<http://example.org/colours-gb/colour>
    a skos:Concept ;
    skos:inScheme <http://example.org/colours-gb/> ;
    skos:prefLabel "Colour"@en-gb ;
    skos:altLabel "Hue"@en-gb ;
    skos:note "The visible spectral quality of light."@en-gb .
