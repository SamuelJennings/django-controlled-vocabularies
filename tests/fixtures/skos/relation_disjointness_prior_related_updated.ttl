@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# The re-import half of the pair (see relation_disjointness_prior_related.ttl).
# b is gone from this file entirely; a now states skos:broader against it.

<http://example.org/disjoint2/>
    a skos:ConceptScheme ;
    skos:prefLabel "Disjointness reimport"@en .

<http://example.org/disjoint2/a>
    a skos:Concept ;
    skos:inScheme <http://example.org/disjoint2/> ;
    skos:prefLabel "A"@en ;
    skos:broader <http://example.org/disjoint2/b> .
