@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FIX 6 (review, decisions.md D40) — a concept stating skos:broader about
# itself. D29 already treats the equivalent skos:related shape as a no-op
# (the model's own _reject_self would refuse it); skos:broader had no such
# guard and crashed the run instead.

<http://example.org/selfref/>
    a skos:ConceptScheme ;
    skos:prefLabel "Self reference"@en .

<http://example.org/selfref/loop>
    a skos:Concept ;
    skos:inScheme <http://example.org/selfref/> ;
    skos:prefLabel "Loop"@en ;
    skos:broader <http://example.org/selfref/loop> .
