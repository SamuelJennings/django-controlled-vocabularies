@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# T025/SC-024, S6 SEC-002, decisions.md D34: a 300-character skos:altLabel in a
# variant of a configured language (en-GB, a variant of "en") reaches
# Concept.add_label, whose full_clean() refuses text beyond 255 characters. The
# value is set aside and reported; the rest of the file, including the rest of
# this concept, still imports.

<http://example.org/longvalue/>
    a skos:ConceptScheme ;
    skos:prefLabel "Long value test"@en .

<http://example.org/longvalue/ok>
    a skos:Concept ;
    skos:inScheme <http://example.org/longvalue/> ;
    skos:prefLabel "OK"@en ;
    skos:altLabel "OK-alt"@en .

<http://example.org/longvalue/toolong>
    a skos:Concept ;
    skos:inScheme <http://example.org/longvalue/> ;
    skos:prefLabel "TooLong"@en ;
    skos:altLabel ""@en-GB .
