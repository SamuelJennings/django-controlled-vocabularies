@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# FIX 15 (review): a literal with no language tag — or an object that is not
# even a Literal at all — carried by skos:altLabel/skos:definition (and the
# dcterms:description alias) must be set aside and reported, never dropped
# in silence. "alpha" carries an untagged alternative label and an untagged
# definition; "beta" carries a skos:definition whose object is a URI, not a
# literal at all; "gamma" carries no skos:definition of its own but an
# untagged dcterms:description, so the untagged-ness applies to the alias
# path too, not only the native skos:definition predicate.

<http://example.org/untagged/>
    a skos:ConceptScheme ;
    skos:prefLabel "Untagged"@en .

<http://example.org/untagged/alpha>
    a skos:Concept ;
    skos:inScheme <http://example.org/untagged/> ;
    skos:prefLabel "Alpha"@en ;
    skos:altLabel "plain alt" ;
    skos:definition "plain definition" .

<http://example.org/untagged/beta>
    a skos:Concept ;
    skos:inScheme <http://example.org/untagged/> ;
    skos:prefLabel "Beta"@en ;
    skos:definition <http://example.org/untagged/somewhere> .

<http://example.org/untagged/gamma>
    a skos:Concept ;
    skos:inScheme <http://example.org/untagged/> ;
    skos:prefLabel "Gamma"@en ;
    dcterms:description "plain description" .
