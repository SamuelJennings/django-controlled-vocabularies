@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# T017: a re-import of the "rocks" vocabulary that would correct granite's
# label if it landed, alongside a blank-node concept that fails the whole
# run (D3/FR-004). Existing T011 coverage proves a fatal re-import rolls
# back a *scheme field write* and *creation*; this fixture is for proving it
# also rolls back an *update to an already-existing concept* — the case the
# transaction boundary could get wrong if it only protected creation.

<http://example.org/rocks/>
    a skos:ConceptScheme ;
    skos:prefLabel "Rock types"@en ;
    skos:hasTopConcept <http://example.org/rocks/igneous> .

<http://example.org/rocks/granite>
    a skos:Concept ;
    skos:inScheme <http://example.org/rocks/> ;
    skos:prefLabel "Granite (should not land)"@en .

[] a skos:Concept ;
    skos:inScheme <http://example.org/rocks/> ;
    skos:prefLabel "Ghost concept"@en .
