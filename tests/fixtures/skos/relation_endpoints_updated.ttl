@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# The re-import half of the pair (see relation_endpoints.ttl). Beta is no
# longer declared as a concept here at all, but alpha still states a broader
# relationship to it — beta is already in the database from the first
# import, so the relationship must still be stored (spec.md US-4 acceptance
# 6). Alpha also gains a related edge to a URI that has never existed in
# either file nor the database, which must be set aside and reported instead
# (acceptance 5), without failing the run.

<http://example.org/relendpoints/>
    a skos:ConceptScheme ;
    skos:prefLabel "Relation endpoints"@en .

<http://example.org/relendpoints/alpha>
    a skos:Concept ;
    skos:inScheme <http://example.org/relendpoints/> ;
    skos:prefLabel "Alpha"@en ;
    skos:broader <http://example.org/relendpoints/beta> ;
    skos:related <http://example.org/relendpoints/ghost> .
