@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# FIX 2 (review, decisions.md D37), route 2 — a related row an earlier
# import created can survive into a later run that then states the same
# pair as broader. b drops out of the second file entirely
# (relation_disjointness_prior_related_updated.ttl), so its own end is
# never rewritten by that run and the "both ends" deletion rule (D30) never
# gets a chance to remove the stale related row before add_broader would
# otherwise crash on it.

<http://example.org/disjoint2/>
    a skos:ConceptScheme ;
    skos:prefLabel "Disjointness reimport"@en .

<http://example.org/disjoint2/a>
    a skos:Concept ;
    skos:inScheme <http://example.org/disjoint2/> ;
    skos:prefLabel "A"@en ;
    skos:related <http://example.org/disjoint2/b> .

<http://example.org/disjoint2/b>
    a skos:Concept ;
    skos:inScheme <http://example.org/disjoint2/> ;
    skos:prefLabel "B"@en .
