@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/ns#> .

# T021/FR-009/FR-014: a notation, a mapping to another vocabulary, and a
# predicate from outside SKOS entirely — none of which the models have a
# place for — each set aside and reported rather than passed over in
# silence. "widget" carries all three; "gadget" carries no
# skos:definition of its own but does carry a foreign dcterms:description,
# which is read as its definition and reported as a normalisation, never
# applied silently.

<http://example.org/hardware/>
    a skos:ConceptScheme ;
    skos:prefLabel "Hardware"@en .

<http://example.org/hardware/widget>
    a skos:Concept ;
    skos:inScheme <http://example.org/hardware/> ;
    skos:prefLabel "Widget"@en ;
    skos:notation "W-100" ;
    skos:exactMatch <http://external.example.org/parts/widget> ;
    ex:customAttribute "Not modelled by this application" .

<http://example.org/hardware/gadget>
    a skos:Concept ;
    skos:inScheme <http://example.org/hardware/> ;
    skos:prefLabel "Gadget"@en ;
    dcterms:description "A small mechanical device."@en .
