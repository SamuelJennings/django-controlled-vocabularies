@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# The re-import half of the pair (see collection_lifecycle.ttl). alpha
# restates its membership unchanged. beta stays present as a concept here
# but is dropped from "group"'s own member list — a genuine retraction
# FR-013 requires this run to apply. gamma is gone from this file
# altogether, concept and all; decisions.md D30 leaves gamma's own
# collection membership exactly as it was, since gamma's end was never
# rewritten by this run. delta is new, proving a re-import also adds a
# member it did not hold before. "missing" is not restated, and never
# existed as a concept in the first place.

<http://example.org/lifecycle-collections/>
    a skos:ConceptScheme ;
    skos:prefLabel "Collection lifecycle"@en .

<http://example.org/lifecycle-collections/alpha>
    a skos:Concept ;
    skos:inScheme <http://example.org/lifecycle-collections/> ;
    skos:prefLabel "Alpha"@en .

<http://example.org/lifecycle-collections/beta>
    a skos:Concept ;
    skos:inScheme <http://example.org/lifecycle-collections/> ;
    skos:prefLabel "Beta"@en .

<http://example.org/lifecycle-collections/delta>
    a skos:Concept ;
    skos:inScheme <http://example.org/lifecycle-collections/> ;
    skos:prefLabel "Delta"@en .

<http://example.org/lifecycle-collections/collection/group>
    a skos:Collection ;
    skos:prefLabel "Group"@en ;
    skos:member
        <http://example.org/lifecycle-collections/alpha>,
        <http://example.org/lifecycle-collections/delta> .
