@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# The re-import half of the pair (see relation_disjointness_prior_broader.ttl).
# b is gone from this file entirely; a now states skos:related against it.

<http://example.org/disjoint3/>
    a skos:ConceptScheme ;
    skos:prefLabel "Disjointness reimport broader"@en .

<http://example.org/disjoint3/a>
    a skos:Concept ;
    skos:inScheme <http://example.org/disjoint3/> ;
    skos:prefLabel "A"@en ;
    skos:related <http://example.org/disjoint3/b> .
