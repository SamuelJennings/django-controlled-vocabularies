@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# T026's own dedicated fixture pair (decisions.md D30) — decisions.md D28
# prefers a fixture per story over a third edit to the shared
# rocks.ttl/rocks_updated.ttl corpus. Three related pairs, each proving a
# different half of a re-import's removal rule: quarry-vein is genuinely
# retracted in relation_lifecycle_updated.ttl, with both concepts staying;
# quarry-outlier's other end, outlier, leaves that file entirely, the case
# decisions.md D30 now leaves untouched rather than deletes; quarry-companion
# is unchanged between the two files, proving the removal above is selective
# rather than a wholesale wipe of every edge touching quarry.

<http://example.org/lifecycle/>
    a skos:ConceptScheme ;
    skos:prefLabel "Relation lifecycle"@en .

<http://example.org/lifecycle/quarry>
    a skos:Concept ;
    skos:inScheme <http://example.org/lifecycle/> ;
    skos:prefLabel "Quarry"@en ;
    skos:related
        <http://example.org/lifecycle/vein>,
        <http://example.org/lifecycle/outlier>,
        <http://example.org/lifecycle/companion> .

<http://example.org/lifecycle/vein>
    a skos:Concept ;
    skos:inScheme <http://example.org/lifecycle/> ;
    skos:prefLabel "Vein"@en .

<http://example.org/lifecycle/outlier>
    a skos:Concept ;
    skos:inScheme <http://example.org/lifecycle/> ;
    skos:prefLabel "Outlier"@en .

<http://example.org/lifecycle/companion>
    a skos:Concept ;
    skos:inScheme <http://example.org/lifecycle/> ;
    skos:prefLabel "Companion"@en .
