@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# A separate vocabulary whose one concept states a relationship to a concept
# that, by the time this file is imported, already exists in the database —
# but under a *different* vocabulary (rocks.ttl's granite). ConceptRelation
# only ever joins concepts of the same scheme (models.py
# _reject_cross_scheme); decisions.md D29 records that this is treated the
# same as a missing end rather than left to raise an uncaught
# ValidationError.

<http://example.org/outsiders/>
    a skos:ConceptScheme ;
    skos:prefLabel "Outsiders"@en .

<http://example.org/outsiders/outsider>
    a skos:Concept ;
    skos:inScheme <http://example.org/outsiders/> ;
    skos:prefLabel "Outsider"@en ;
    skos:broader <http://example.org/rocks/granite> .
