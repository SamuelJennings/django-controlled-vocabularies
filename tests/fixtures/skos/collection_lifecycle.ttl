@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# T029's own dedicated fixture pair (decisions.md D28 prefers a new fixture
# over a third edit to the shared rocks.ttl/rocks_updated.ttl corpus). Four
# members side by side in "group", each proving a different half of a
# re-import's membership rule: alpha stays a member across both files; beta
# stays present as a concept but is genuinely dropped from the collection
# statement; gamma leaves the file entirely, taking no explicit collection
# statement about it with it — decisions.md D30's own rule, applied to
# membership rather than a relation; "missing" is a member neither in this
# file nor already in the database at all.

<http://example.org/lifecycle-collections/>
    a skos:ConceptScheme ;
    skos:prefLabel "Collection lifecycle"@en .

<http://example.org/lifecycle-collections/alpha>
    a skos:Concept ;
    skos:inScheme <http://example.org/lifecycle-collections/> ;
    skos:prefLabel "Alpha"@en .

<http://example.org/lifecycle-collections/beta>
    a skos:Concept ;
    skos:inScheme <http://example.org/lifecycle-collections/> ;
    skos:prefLabel "Beta"@en .

<http://example.org/lifecycle-collections/gamma>
    a skos:Concept ;
    skos:inScheme <http://example.org/lifecycle-collections/> ;
    skos:prefLabel "Gamma"@en .

<http://example.org/lifecycle-collections/collection/group>
    a skos:Collection ;
    skos:prefLabel "Group"@en ;
    skos:member
        <http://example.org/lifecycle-collections/alpha>,
        <http://example.org/lifecycle-collections/beta>,
        <http://example.org/lifecycle-collections/gamma>,
        <http://example.org/lifecycle-collections/missing> .
