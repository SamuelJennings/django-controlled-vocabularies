@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# The first half of a two-file pair (tasks.md T025, spec.md US-4 acceptance
# 5/6): alpha and beta both land here, with a stored relationship between
# them. relation_endpoints_updated.ttl re-imports with beta dropped from the
# file — beta is already in the database by then, so the relationship
# survives — and adds a second relationship to an end that has never existed
# anywhere, which must be set aside instead.

<http://example.org/relendpoints/>
    a skos:ConceptScheme ;
    skos:prefLabel "Relation endpoints"@en .

<http://example.org/relendpoints/alpha>
    a skos:Concept ;
    skos:inScheme <http://example.org/relendpoints/> ;
    skos:prefLabel "Alpha"@en ;
    skos:broader <http://example.org/relendpoints/beta> .

<http://example.org/relendpoints/beta>
    a skos:Concept ;
    skos:inScheme <http://example.org/relendpoints/> ;
    skos:prefLabel "Beta"@en .
